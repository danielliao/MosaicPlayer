# Copy to a private file (chmod 600). Never commit real values.
# Runtime role: NOSUPERUSER NOBYPASSRLS and not table owner.
COMMERCIAL_DATABASE_URL=postgres://mosaic_runtime:REPLACE@postgres.internal:5432/mosaic_commercial
# Migration/bootstrap jobs only. Do not inject the owner URL into the app container.
COMMERCIAL_OWNER_URL=postgres://mosaic_owner:REPLACE@postgres.internal:5432/mosaic_commercial
COMMERCIAL_ADMIN_USERNAME=platform-admin
COMMERCIAL_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_20_PLUS_CHAR_PASSWORD
COMMERCIAL_COOKIE_SECURE=true
COMMERCIAL_TRUST_PROXY=1
COMMERCIAL_APK_SIGNER_SHA256=REPLACE_WITH_YOUR_APK_CERTIFICATE_SHA256
MOSAIC_DOMAIN=signage.example.com
MOSAIC_DATA_PATH=/srv/mosaic/data
MOSAIC_DOWNLOAD_PATH=/srv/mosaic/downloads

# External AI is opt-in. Keys are managed privately in the console.
COMMERCIAL_AI_ENABLED=false
# Exact trusted gateway hostnames only; blank keeps public HTTPS-only access.
COMMERCIAL_AI_ALLOWED_HOSTS=
