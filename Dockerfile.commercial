FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg aapt apksigner postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY commercial ./commercial
COPY lib ./lib
COPY public ./public
COPY scripts ./scripts
RUN mkdir -p /data && chown node:node /data
USER node
ENV NODE_ENV=production COMMERCIAL_DATA_DIR=/data COMMERCIAL_PORT=3210
EXPOSE 3210
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
 CMD node -e "fetch('http://127.0.0.1:3210/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","commercial/server.js"]
